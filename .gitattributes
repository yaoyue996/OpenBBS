# Normalize line endings across platforms
* text=auto

*.sh   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ejs  text eol=lf
*.sql  text eol=lf
*.ps1  text eol=crlf

*.db   binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
