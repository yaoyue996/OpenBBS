<% if (pager && pager.pageCount > 1) { %>
  <nav class="pagination" aria-label="分页">
    <% if (pager.hasPrev) { %>
      <a class="page-btn" href="<%= queryUrl({ page: pager.prevPage }) %>" rel="prev" aria-label="上一页"><%- icon('arrow-left') %></a>
    <% } else { %>
      <span class="page-btn page-btn--disabled" aria-hidden="true"><%- icon('arrow-left') %></span>
    <% } %>
    <% pageNumbers(pager.page, pager.pageCount).forEach((item) => { %>
      <% if (item === '…') { %>
        <span class="page-ellipsis">…</span>
      <% } else if (item === pager.page) { %>
        <span class="page-btn is-current" aria-current="page"><%= item %></span>
      <% } else { %>
        <a class="page-btn" href="<%= queryUrl({ page: item }) %>"><%= item %></a>
      <% } %>
    <% }) %>
    <% if (pager.hasNext) { %>
      <a class="page-btn" href="<%= queryUrl({ page: pager.nextPage }) %>" rel="next" aria-label="下一页"><%- icon('arrow-right') %></a>
    <% } else { %>
      <span class="page-btn page-btn--disabled" aria-hidden="true"><%- icon('arrow-right') %></span>
    <% } %>
  </nav>
<% } %>
