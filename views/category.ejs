<%- include('partials/head') %>

<nav class="breadcrumb" aria-label="面包屑">
  <a href="/">首页</a><span>/</span><a href="/topics">话题</a><span>/</span><span><%= category.name %></span>
</nav>

<section class="category-hero" style="--cat-color: <%= category.color %>">
  <span class="category-hero-icon"><%= category.icon %></span>
  <div class="category-hero-body">
    <h1><%= category.name %></h1>
    <p><%= category.description %></p>
    <div class="category-hero-meta">
      <span><%- icon('message') %><%= formatNumber(category.topic_count) %> 个主题</span>
      <span><%- icon('reply') %><%= formatNumber(category.post_count) %> 条回复</span>
    </div>
  </div>
  <a class="btn btn-primary" href="<%= user ? `/new?category=${category.id}` : `/login?next=${encodeURIComponent(`/new?category=${category.id}`)}` %>"><%- icon('plus') %>发布主题</a>
</section>

<div class="toolbar">
  <div class="tabs">
    <a href="<%= queryUrl({ sort: 'latest', page: null }) %>" class="<%= sort === 'latest' ? 'is-active' : '' %>">最新回复</a>
    <a href="<%= queryUrl({ sort: 'new', page: null }) %>" class="<%= sort === 'new' ? 'is-active' : '' %>">最新发布</a>
    <a href="<%= queryUrl({ sort: 'hot', page: null }) %>" class="<%= sort === 'hot' ? 'is-active' : '' %>">热门</a>
  </div>
  <span class="muted">共 <%= formatNumber(total) %> 个主题</span>
</div>

<% if (topics.length === 0) { %>
  <div class="empty-state card">
    <span class="empty-icon">🌱</span>
    <h3>这个分类还没有主题</h3>
    <p>成为第一个在这里发言的人。</p>
    <a class="btn btn-primary" href="<%= user ? `/new?category=${category.id}` : '/login' %>">发布主题</a>
  </div>
<% } else { %>
  <div class="topic-list card topic-list--card">
    <% topics.forEach((topic) => { %>
      <%- include('partials/topic-row', { topic, showCategory: false }) %>
    <% }) %>
  </div>
  <%- include('partials/pagination', { pager }) %>
<% } %>

<%- include('partials/footer') %>
