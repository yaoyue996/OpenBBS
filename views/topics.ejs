<%- include('partials/head') %>

<div class="page-head">
  <div>
    <span class="eyebrow">Topics</span>
    <h1><%= category ? category.name : '全部话题' %></h1>
    <p class="page-sub"><%= category ? category.description : '浏览社区中的所有讨论' %><% if (total) { %> · 共 <%= formatNumber(total) %> 个主题<% } %></p>
  </div>
  <a class="btn btn-primary" href="<%= user ? (category ? `/new?category=${category.id}` : '/new') : '/login?next=/new' %>"><%- icon('plus') %>发布主题</a>
</div>

<div class="toolbar">
  <div class="tabs">
    <a href="<%= queryUrl({ sort: 'latest', page: null }) %>" class="<%= sort === 'latest' ? 'is-active' : '' %>">最新回复</a>
    <a href="<%= queryUrl({ sort: 'new', page: null }) %>" class="<%= sort === 'new' ? 'is-active' : '' %>">最新发布</a>
    <a href="<%= queryUrl({ sort: 'hot', page: null }) %>" class="<%= sort === 'hot' ? 'is-active' : '' %>">热门</a>
  </div>
  <div class="category-pills">
    <a href="<%= queryUrl({ category: null, page: null }) %>" class="category-pill<%= !categoryId ? ' is-active' : '' %>">全部</a>
    <% categories.forEach((item) => { %>
      <a href="<%= queryUrl({ category: item.id, page: null }) %>" class="category-pill<%= categoryId === item.id ? ' is-active' : '' %>" style="--cat-color: <%= item.color %>"><%= item.icon %> <%= item.name %></a>
    <% }) %>
  </div>
</div>

<% if (topics.length === 0) { %>
  <div class="empty-state card">
    <span class="empty-icon">🫧</span>
    <h3>这里还很安静</h3>
    <p>没有找到相关主题，换个分类看看，或者发布第一个主题。</p>
    <a class="btn btn-primary" href="<%= user ? '/new' : '/login?next=/new' %>">发布主题</a>
  </div>
<% } else { %>
  <div class="topic-list card topic-list--card">
    <% topics.forEach((topic) => { %>
      <%- include('partials/topic-row', { topic }) %>
    <% }) %>
  </div>
  <%- include('partials/pagination', { pager }) %>
<% } %>

<%- include('partials/footer') %>
