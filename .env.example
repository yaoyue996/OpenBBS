# ---------------------------------------------------------------------------
# OpenBBS environment configuration
# Copy this file to `.env` and adjust the values, or let the installer do it.
# ---------------------------------------------------------------------------

# HTTP server
HOST=0.0.0.0
PORT=3000

# Public URL of your forum (used for origin checks, RSS and canonical links).
# In production set this to e.g. https://bbs.example.com
SITE_URL=http://localhost:3000

# SQLite database location (relative paths are resolved from the project root)
DATABASE_PATH=data/openbbs.db

# Set to 1 when running behind a reverse proxy (Nginx, Caddy, Cloudflare, ...)
TRUST_PROXY=0

# Cookie security: auto | always | never
# "auto" marks cookies Secure when the request is HTTPS.
COOKIE_SECURE=auto

# Environment: production | development
NODE_ENV=production

# ---------------------------------------------------------------------------
# First-run administrator. Leave ADMIN_PASSWORD empty to auto-generate a
# password (it is printed once and stored in data/initial-admin.txt).
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Site name and description can also be changed later in Admin -> Settings.
SITE_NAME=OpenBBS
SITE_DESCRIPTION=一个属于你的开源社区
